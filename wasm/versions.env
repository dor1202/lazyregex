# Pinned upstream sources for the WASM engine builds (make wasm-*).
# Every download is verified against the SHA-256 recorded here.

# wasi-sdk: https://github.com/WebAssembly/wasi-sdk/releases/tag/wasi-sdk-34
WASI_SDK_VERSION=34.0
WASI_SDK_SHA256_ARM64=f7e243dff54d60bcc576e94d6166b69f410f2500ae4a9ceef34315be10e77971
WASI_SDK_SHA256_X86_64=b761e3a0721dbae9c09a0059e5fdb2bf917d1b4a8a7b430fb3b5aafb0984b2c4

# PCRE2: https://github.com/PCRE2Project/pcre2/releases/tag/pcre2-10.44 (pcre2-10.44.tar.gz)
# 10.44 is the library bundled with PHP 8.4 (ext/pcre/pcre2lib), whose preg_*
# results are the parity referee. Later releases (10.45+, "improved error
# offsets", PCRE2 #756) report compile-error offsets differently from PHP.
PCRE2_VERSION=10.44
PCRE2_SHA256=86b9cb0aa3bcb7994faa88018292bc704cdbb708e785f7c74352ff6ea7d3175b

