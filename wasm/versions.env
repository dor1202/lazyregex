# Pinned upstream sources for the WASM engine builds (make wasm-*).
# Every download is verified against the SHA-256 recorded here.

# wasi-sdk: https://github.com/WebAssembly/wasi-sdk/releases/tag/wasi-sdk-34
WASI_SDK_VERSION=34.0
WASI_SDK_SHA256_ARM64=f7e243dff54d60bcc576e94d6166b69f410f2500ae4a9ceef34315be10e77971
WASI_SDK_SHA256_X86_64=b761e3a0721dbae9c09a0059e5fdb2bf917d1b4a8a7b430fb3b5aafb0984b2c4

# PCRE2: https://github.com/PCRE2Project/pcre2/releases/tag/pcre2-10.44 (pcre2-10.44.tar.gz)
# 10.44 is the library bundled with PHP 8.4 (ext/pcre/pcre2lib), whose preg_*
# results are the parity referee. Later releases (10.45+, "improved error
# offsets", PCRE2 #756) report compile-error offsets differently from PHP.
PCRE2_VERSION=10.44
PCRE2_SHA256=86b9cb0aa3bcb7994faa88018292bc704cdbb708e785f7c74352ff6ea7d3175b

# QuickJS-ng: https://github.com/quickjs-ng/quickjs/archive/refs/tags/v0.17.0.tar.gz
QUICKJS_NG_VERSION=0.17.0
QUICKJS_NG_SHA256=559bc4c420475e55c7ab4510adbc562f55d7524d75e8e89d79ce4bb02f5687d9

# CPython: https://www.python.org/ftp/python/3.14.9/Python-3.14.9.tgz
# (sha256 matches the digest in the release's Python-3.14.9.tgz.sigstore bundle)
CPYTHON_VERSION=3.14.9
CPYTHON_SHA256=8b47e85ee67e93945e93620a051a8f44bfc1e9735ed67075d166f4a74b7a060b

# wasi-sdk for CPython: 3.14's Tools/wasm/wasi supports exactly WASI SDK 24
# (WASI_SDK_VERSION in Tools/wasm/wasi/__main__.py).
# https://github.com/WebAssembly/wasi-sdk/releases/tag/wasi-sdk-24
CPYTHON_WASI_SDK_VERSION=24.0
CPYTHON_WASI_SDK_SHA256_ARM64=ae6c1417ea161e54bc54c0a168976af57a0c6e53078857886057a71a0d928646
CPYTHON_WASI_SDK_SHA256_X86_64=c6c38aab56e5de88adf6c1ebc9c3ae8da72f88ec2b656fb024eda8d4167a0bc5
